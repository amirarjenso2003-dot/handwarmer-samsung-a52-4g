/* Thermal Zone Adjustments - Raise trip points +4-5°C */
&soc {
	gpuss_thermal: gpuss-thermal {
		polling-delay-passive = <100>;
		polling-delay = <1000>;
		thermal-governor = "step_wise";
		thermal-sensors = <&tsens0 13>;

		trips {
			gpuss_alert0: gpu-alert0 {
				temperature = <80000>; /* Raised from 75°C */
				hysteresis = <5000>;
				type = "passive";
			};

			gpuss_alert1: gpu-alert1 {
				temperature = <85000>; /* Raised from 80°C */
				hysteresis = <5000>;
				type = "passive";
			};

			gpuss_alert2: gpu-alert2 {
				temperature = <90000>; /* Raised from 85°C */
				hysteresis = <5000>;
				type = "passive";
			};

			gpuss_crit: gpu-crit {
				temperature = <105000>; /* Critical */
				hysteresis = <5000>;
				type = "critical";
			};
		};

		cooling-maps {
			gpu_cdev0 {
				trip = <&gpuss_alert0>;
				cooling-device = <&msm_gpu THERMAL_NO_LIMIT 2>;
				contribution = <50>;
			};

			gpu_cdev1 {
				trip = <&gpuss_alert1>;
				cooling-device = <&msm_gpu 2 5>;
				contribution = <75>;
			};

			gpu_cdev2 {
				trip = <&gpuss_alert2>;
				cooling-device = <&msm_gpu 5 THERMAL_MAX_LIMIT>;
				contribution = <100>;
			};
		};
	};
};